# Per-worker runtime: DSH home, browser profile, workspaces, evidence.
.workers/
.workers-*/

# Legacy single-instance runtime paths, kept ignored so stale dirs never leak.
.dsh/
.browser/
.workspace/

# Local config with provider keys and allowed routes; copy config.example.json and fill the real values.
config.json
node_modules
*.log
.DS_Store

# Regenerated raw baseline. The generator never writes the upstream checkout.
raw/pstack/
raw/upstream/
raw/scripts/
raw/manifest.json

# Generated per-run reports: evidence files are ignored, summaries/approvals are committed.
reports/**/record.json
reports/**/screenshot.png
reports/**/full.png
reports/**/session.jsonl.zstd

# Per-run report snapshots are local comparison history, not repository content.
reports/**/history/

# Legacy archived evidence; regenerated per run.
reports/evidence/

# Review sidecars under reviews/ are reviewed source files committed with the repo; never ignore them.
